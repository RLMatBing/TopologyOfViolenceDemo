# Required for durable, cross-instance multiplayer on Vercel.
# Create an Upstash Redis database via the Vercel Marketplace, then add its TLS URL.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_UPSTASH_HOST:6379

# Required to protect the host-only creation page at /admin in production.
ADMIN_PASSWORD=replace-with-a-long-unique-password
